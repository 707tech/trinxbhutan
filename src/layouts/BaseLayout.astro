---
import { url } from '../utils/url';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/geist';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import UtilityBar from '../components/UtilityBar.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import Icon from '../components/Icon.astro';
import { SITE_NAME, SITE_BY, SITE_URL, WHATSAPP_NUMBER } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  variant?: 'overlay' | 'solid';
  active?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Trinx bicycles in Bhutan — mountain, road, gravel, city and kids’ bikes, parts and gear, plus bike servicing, from Gangjung Traders.',
  variant = 'solid',
  active = 'Home',
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — bikes, parts and servicing`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const ld = { '@context': 'https://schema.org', '@type': 'BicycleStore', name: SITE_NAME, parentOrganization: { '@type': 'Organization', name: SITE_BY }, url: SITE_URL, areaServed: 'Bhutan' };
---
<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-full flex-col font-display text-black">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-accent focus:px-5 focus:py-2 focus:text-white">Skip to content</a>
    {variant === 'solid' && <UtilityBar />}
    <Header variant={variant} active={active} />
    <SearchOverlay />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />

    <div id="chat-widget" data-wa={WHATSAPP_NUMBER} class="fixed right-4 bottom-4 z-40 flex flex-col items-end gap-3">
      <div id="chat-panel" role="dialog" aria-label="Chat with Gangjung Traders" hidden class="chat-panel w-[min(320px,calc(100vw-2rem))] overflow-hidden rounded-2xl border border-white/40 bg-white/70 text-black shadow-[0_16px_48px_rgba(0,0,0,0.22)] backdrop-blur-xl backdrop-saturate-150">
        <div class="flex items-center gap-3 bg-accent/90 px-4 py-3 text-white">
          <span class="relative flex h-9 w-9 items-center justify-center rounded-full bg-white/20"><Icon name="chat" size={18} /><span class="absolute right-0 bottom-0 h-2.5 w-2.5 rounded-full border-2 border-accent bg-green-400"></span></span>
          <div class="min-w-0 flex-1"><p class="text-[12px] font-semibold uppercase">Gangjung Traders</p><p class="font-sans text-[11px] text-white/80">Typically replies in minutes</p></div>
          <button type="button" id="chat-close" aria-label="Close chat" class="p-1 transition-opacity hover:opacity-70"><Icon name="close" size={18} /></button>
        </div>
        <div class="min-h-[96px] px-4 py-4">
          <div id="chat-typing" class="chat-bubble inline-flex gap-1 rounded-2xl rounded-bl-sm bg-white px-4 py-3 shadow-sm" aria-hidden="true"><span class="chat-dot"></span><span class="chat-dot"></span><span class="chat-dot"></span></div>
          <p id="chat-msg" hidden class="chat-bubble max-w-[85%] rounded-2xl rounded-bl-sm bg-white px-4 py-3 font-sans text-[14px] leading-5 shadow-sm">Hi! 👋 This is Gangjung Traders. How can we help you?</p>
        </div>
        <form id="chat-form" hidden class="chat-bubble flex items-center gap-2 border-t border-black/10 bg-white/60 p-3">
          <input id="chat-input" type="text" placeholder="Type your message…" aria-label="Your message" autocomplete="off" class="min-w-0 flex-1 rounded-full border border-black/10 bg-white px-4 py-2.5 font-sans text-[13px] focus:border-accent focus:outline-none" />
          <button type="submit" aria-label="Send on WhatsApp" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent text-white transition-colors hover:bg-black"><Icon name="arrow-up" size={16} /></button>
        </form>
      </div>
      <button type="button" id="chat-toggle" aria-expanded="false" aria-controls="chat-panel" aria-label="Chat with Gangjung Traders" class="flex h-10 items-center justify-center gap-2 rounded-full border border-white/40 bg-accent/55 px-3 text-[10px] font-semibold text-white uppercase shadow-[0_8px_24px_rgba(0,0,0,0.18),inset_0_1px_0_rgba(255,255,255,0.35)] backdrop-blur-md backdrop-saturate-150 transition-colors duration-300 hover:bg-accent/80 sm:px-4">
        <Icon name="chat" size={16} /><span class="hidden sm:inline">Gangjung Traders</span>
      </button>
    </div>
    <div id="toast" role="status" aria-live="polite" class="pointer-events-none fixed bottom-5 left-1/2 z-[90] hidden -translate-x-1/2 items-center gap-3 bg-accent px-5 py-3 text-[11px] font-medium text-white uppercase shadow-lg"></div>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
