---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import StockStatus from './StockStatus.astro';
import { photo } from '../lib/photos';
import { formatPrice } from '../lib/format';
import type { ShopItem } from '../data/catalogue';

interface Props { item: ShopItem; eager?: boolean }
const { item, eager = false } = Astro.props;
const hasRange = item.priceMax !== undefined;
const hasOptions = hasRange || item.kind === 'bike';
const soldOut = !item.inStock;
const thumb = (await getImage({ src: photo(item.images[0]), width: 200, height: 200, fit: 'cover' } as any)).src;
const arrowBtn = 'absolute top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 items-center justify-center bg-white/90 text-black transition-all duration-300 hover:bg-accent hover:text-white md:opacity-0 md:group-hover:opacity-100';
const badge = item.badge === 'New' ? '• New' : item.badge === 'Sale' ? 'Sale' : null;
---
<article data-card data-key={item.key} data-kind={item.kind} data-category={item.category} class="group relative flex h-full flex-col bg-white p-5 hover:z-10 hover:shadow-[0_12px_32px_rgba(0,0,0,0.08)]">
  <div class="relative aspect-square overflow-hidden bg-card">
    {item.images.map((id, i) => (
      <Image src={photo(id)} alt={i === 0 ? item.name : ''} width={640} height={640} sizes="(min-width:1024px) 25vw, (min-width:640px) 50vw, 100vw" loading={eager && i === 0 ? 'eager' : 'lazy'} data-card-img data-active={String(i === 0)} class:list={['absolute inset-0 h-full w-full object-cover transition-all duration-500 group-hover:scale-105', i === 0 ? 'opacity-100' : 'opacity-0', soldOut && 'grayscale-[60%]']} />
    ))}
    <a href={item.href} tabindex="-1" aria-hidden="true" class="absolute inset-0 z-[1]"></a>
    {soldOut ? (
      <span class="absolute top-3 left-3 z-10 flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-[10px] font-medium uppercase shadow-sm"><span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>Sold out</span>
    ) : badge && (
      <span class="absolute top-3 left-3 z-10 rounded-full bg-accent px-2.5 py-1 text-[10px] font-medium text-white uppercase">{badge}</span>
    )}
    {item.images.length > 1 && (
      <>
        <button type="button" data-card-step="-1" aria-label="Previous image" class={`${arrowBtn} left-2`}><Icon name="chev-left" size={16} /></button>
        <button type="button" data-card-step="1" aria-label="Next image" class={`${arrowBtn} right-2`}><Icon name="chev-right" size={16} /></button>
      </>
    )}
  </div>

  {item.colors.length > 0 && (
    <div class="mt-4 flex gap-1.5" aria-label="Available colors">
      {item.colors.map((c) => <span class="h-3 w-3 rounded-full border border-black/15" style={`background:${c}`}></span>)}
    </div>
  )}

  <p class="eyebrow mt-3">{item.brand}</p>
  <h3 class="mt-1 text-[12px] leading-snug font-semibold uppercase"><a href={item.href} class="transition-colors duration-300 hover:text-accent">{item.name}</a></h3>
  <p class="mt-1 text-[11px] text-muted uppercase">{item.category}</p>
  <StockStatus inStock={item.inStock} class="mt-2.5" />

  <div class="mt-auto flex items-end justify-between gap-3 pt-4">
    <p class="text-[13px] font-semibold">
      {item.onRequest ? <span class="text-[12px] font-semibold text-accent">Price on request</span> : hasRange ? `${formatPrice(item.price)} – ${formatPrice(item.priceMax!)}` : formatPrice(item.price)}
      {item.oldPrice && <span class="ml-2 text-[11px] font-normal text-muted line-through">{formatPrice(item.oldPrice)}</span>}
    </p>
    {hasOptions || soldOut ? (
      <a href={item.href} aria-label={`Choose options for ${item.name}`} class="flex h-9 w-9 shrink-0 items-center justify-center border-[1.5px] border-black transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white"><Icon name="arrow-right" size={16} /></a>
    ) : (
      <button type="button" data-add data-id={item.key} data-name={item.name} data-image={thumb} data-price={item.price} data-href={item.href} aria-label={`Add ${item.name} to cart`} class="flex h-9 w-9 shrink-0 items-center justify-center border-[1.5px] border-black transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white"><Icon name="plus" size={16} /></button>
    )}
  </div>
</article>
