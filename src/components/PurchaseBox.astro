---
import Icon from './Icon.astro';
import StockStatus from './StockStatus.astro';
import { SITE_URL, WHATSAPP_NUMBER } from '../data/site';

interface Opt { name: string; swatch?: string }
interface Props {
  id: string; name: string; price: number; priceLabel: string; image: string; path: string; isBicycle?: boolean;
  colors?: Opt[]; sizes?: string[]; soldOut?: boolean; shareName: string; sizeWide?: boolean; onRequest?: boolean;
}
const { id, name, price, priceLabel, image, path, isBicycle = false, colors = [], sizes = [], soldOut = false, shareName, sizeWide = false, onRequest = false } = Astro.props;
const color0 = colors.length > 1 || (isBicycle && colors.length) ? colors[0]?.name : undefined;
const size0 = sizes[0];
---
<div data-purchase data-id={id} data-name={name} data-price={price} data-pricelabel={priceLabel} data-image={image} data-path={path} data-bicycle={String(isBicycle)} data-wa={WHATSAPP_NUMBER} data-siteurl={SITE_URL === 'https://trinx.example.com' ? '' : SITE_URL} data-color={color0 ?? ''} data-size={size0 ?? ''}>
  {(colors.length > 1 || sizes.length > 0 || (isBicycle && colors.length > 0)) && (
    <div class="mt-8 space-y-5">
      {colors.length > 1 && (
        <fieldset>
          <legend class="text-[10px] uppercase">Color: <span class="text-muted" data-opt-label="color">{colors[0].name}</span></legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {colors.map((c, i) => (
              <button type="button" data-opt="color" data-value={c.name} aria-pressed={String(i === 0)} aria-label={c.name} title={c.name} class="flex h-8 w-8 items-center justify-center rounded-full border-[1.5px] border-transparent transition-colors duration-300 hover:border-neutral-400 aria-pressed:border-accent">
                <span class="block h-6 w-6 rounded-full border border-black/15" style={`background:${c.swatch}`}></span>
              </button>
            ))}
          </div>
        </fieldset>
      )}
      {sizes.length > 0 && (
        <fieldset>
          <legend class="text-[10px] uppercase">Size: <span class="text-muted" data-opt-label="size">{sizes[0]}</span></legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {sizes.map((s, i) => (
              <button type="button" data-opt="size" data-value={s} aria-pressed={String(i === 0)} class="flex h-9 min-w-11 items-center justify-center border-[1.5px] border-neutral-300 px-3 text-[11px] font-medium uppercase transition-colors duration-300 hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white">{s}</button>
            ))}
          </div>
        </fieldset>
      )}
    </div>
  )}

  <div class="mt-8 flex flex-wrap items-center gap-3">
    {!onRequest && (<>
    <div class="flex h-[50px] w-[150px] items-center justify-between rounded-full border border-neutral-300 px-2 text-[14px]">
      <button type="button" data-qty-minus aria-label="Decrease quantity" class="h-full w-9 hover:text-accent">−</button>
      <input data-qty-input type="number" min="1" value="1" aria-label={`Quantity for ${name}`} class="w-10 [appearance:textfield] bg-transparent text-center focus:outline-none [&::-webkit-inner-spin-button]:appearance-none" />
      <button type="button" data-qty-plus aria-label="Increase quantity" class="h-full w-9 hover:text-accent">+</button>
    </div>
    <button type="button" data-add-cart disabled={soldOut} class="btn btn-outline h-[50px] disabled:pointer-events-none disabled:opacity-40">{soldOut ? 'Sold out' : 'Add to cart'} <Icon name="bag" size={16} /></button>
    </>)}
    <a data-wa href="#" target="_blank" rel="noopener noreferrer" aria-label={`${soldOut ? 'Ask about restock' : onRequest ? 'Ask for price' : 'Buy on WhatsApp'}: ${name} (opens WhatsApp in a new tab)`} class="btn btn-primary h-[50px]">{soldOut ? 'Ask about restock' : onRequest ? 'Ask for price on WhatsApp' : 'Buy on WhatsApp'} <Icon name="chat" size={16} /></a>
  </div>

  <div data-share data-name={shareName} class="relative mt-6 inline-block">
    <button type="button" data-share-btn aria-expanded="false" aria-haspopup="true" class="-my-2 flex items-center gap-2 py-2 text-[11px] uppercase transition-colors duration-300 hover:text-accent"><Icon name="share" size={16} /> Share</button>
    <div data-share-pop class="absolute top-full left-0 z-20 mt-2 hidden w-48 border border-neutral-200 bg-white py-1 shadow-lg">
      <button type="button" data-share-copy class="flex w-full items-center gap-3 px-4 py-2.5 text-left text-[11px] uppercase transition-colors duration-300 hover:bg-card hover:text-accent"><Icon name="chain" size={15} /><span> Copy link</span></button>
      <a data-share-mail href="#" class="flex w-full items-center gap-3 px-4 py-2.5 text-left text-[11px] uppercase transition-colors duration-300 hover:bg-card hover:text-accent"><Icon name="mail" size={15} /> Email</a>
      <button type="button" data-share-native class="flex w-full items-center gap-3 px-4 py-2.5 text-left text-[11px] uppercase transition-colors duration-300 hover:bg-card hover:text-accent"><Icon name="share" size={15} /> More options</button>
    </div>
  </div>
</div>
