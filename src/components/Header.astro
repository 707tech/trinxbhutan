---
import { url } from '../utils/url';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { homeNav } from '../data/home';

interface Props { variant?: 'overlay' | 'solid'; active?: string }
const { variant = 'solid', active = 'Home' } = Astro.props;
const solid = variant === 'solid';
const linkBase = 'nav-link relative inline-flex items-center gap-2 px-[14px] py-[11px] text-[12px] leading-none font-medium uppercase transition-colors duration-300';
---
<header
  id="site-header"
  data-variant={variant}
  data-solid={solid ? 'true' : 'false'}
  class:list={['site-header z-50 border-b transition-all duration-300', solid ? 'sticky top-0' : 'fixed inset-x-0 top-0']}
>
  <div class="header-bar container-x flex h-[76px] items-center justify-between gap-4 transition-[height] duration-300">
    <div class="flex items-center gap-4">
      <button type="button" id="menu-open" aria-label="Open menu" aria-expanded="false" aria-controls="offcanvas-menu" class="-m-2.5 p-2.5 transition-colors duration-300 hover:text-accent">
        <Icon name="menu" size={24} />
      </button>
      <a href={url('/')} aria-label="Gangjung Traders — home"><Logo class="text-[14px] sm:text-[16px]" sealSize={38} /></a>
    </div>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {homeNav.filter((i) => !i.menuOnly).map((item) =>
          item.children ? (
            <li class="nav-dd relative">
              <button type="button" aria-haspopup="true" aria-expanded="false" class:list={[linkBase, item.label === active && 'is-active']}>
                {item.label} <Icon name="chev-down" size={12} />
              </button>
              <ul class="nav-menu absolute top-full left-0 z-10 hidden min-w-[190px] bg-white p-2 text-black shadow-[0_12px_32px_rgba(0,0,0,0.12)]">
                {item.children.map((c) => <li><a href={c.href} class="block px-4 py-3 text-[11px] font-medium uppercase transition-colors duration-300 hover:text-accent">{c.label}</a></li>)}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} aria-current={item.label === active ? 'page' : undefined} class:list={[linkBase, item.label === active && 'is-active']}>{item.label}</a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-3 sm:gap-5">
      <button type="button" id="search-open" aria-label="Search the site" aria-haspopup="dialog" title="Search (press / )" class="-m-3 p-3 transition-colors duration-300 hover:text-accent"><Icon name="search" size={20} /></button>
      <a href={url('/cart')} aria-label="Cart" data-cart-target class="btn btn-outline px-4 py-[10px]"><Icon name="bag" size={16} /><span data-cart-count>0</span></a>
    </div>
  </div>
</header>

<div id="menu-overlay" class="pointer-events-none fixed inset-0 z-[60] bg-black/50 opacity-0 transition-opacity duration-300" aria-hidden="true"></div>
<aside id="offcanvas-menu" aria-label="Menu" inert class="fixed inset-y-0 left-0 z-[70] flex w-[86%] max-w-sm -translate-x-full flex-col bg-black p-7 text-white transition-transform duration-300">
  <div class="flex items-center justify-between">
    <Logo class="text-[24px]" sealSize={52} />
    <button type="button" id="menu-close" aria-label="Close menu" class="hover:text-accent"><Icon name="close" size={24} /></button>
  </div>
  <ul class="mt-12 space-y-2">
    {homeNav.map((item) =>
      !item.children ? (
        <li><a href={item.href} class:list={['t-h4 block py-2 transition-colors duration-300 hover:text-accent', item.label === active && 'text-accent']}>{item.label}</a></li>
      ) : (
        <li data-sub>
          <div class="flex items-center justify-between gap-4">
            {item.href ? <a href={item.href} class:list={['t-h4 block py-2 transition-colors duration-300 hover:text-accent', item.label === active && 'text-accent']}>{item.label}</a> : <button type="button" data-sub-toggle class:list={['t-h4 block py-2 text-left transition-colors duration-300 hover:text-accent', item.label === active && 'text-accent']}>{item.label}</button>}
            <button type="button" data-sub-toggle aria-expanded="false" aria-label={`Toggle ${item.label} pages`} class="flex h-10 w-10 items-center justify-center rounded-[12px] border-[1.5px] border-white/20 transition-colors duration-300 hover:border-accent hover:text-accent">
              <Icon name="chev-down" size={14} stroke={2.5} class="transition-transform duration-300" />
            </button>
          </div>
          <div class="sub-grid grid grid-rows-[0fr] transition-[grid-template-rows] duration-300">
            <div inert class="overflow-hidden">
              <ul class="mt-1 mb-2 ml-1 space-y-1 border-l border-white/20 pl-4">
                {item.children.filter((c) => c.href !== item.href).map((c) => <li><a href={c.href} class="block py-1.5 text-[12px] font-medium text-white/70 uppercase transition-colors duration-300 hover:text-accent">{c.label}</a></li>)}
              </ul>
            </div>
          </div>
        </li>
      ),
    )}
  </ul>
  <p class="eyebrow mt-auto">Bikes · Parts · Gear — Thimphu, Bhutan</p>
</aside>

<style is:global>
  .nav-link::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: 4px; height: 2px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease; }
  .nav-link:hover::after, .nav-link:focus-visible::after, .nav-link.is-active::after, .nav-dd:hover > .nav-link::after, .nav-dd:focus-within > .nav-link::after { transform: scaleX(1); }
  .site-header[data-solid='true'] { background: #fff; color: #000; border-color: rgba(0, 0, 0, 0.1); }
  .site-header[data-solid='false'] { background: transparent; color: #fff; border-color: rgba(255, 255, 255, 0.2); }
  .site-header[data-compact='true'] { box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06); }
  .site-header[data-compact='true'] .header-bar { height: 60px; }
  .nav-dd:hover .nav-menu, .nav-dd:focus-within .nav-menu, .nav-dd.is-open .nav-menu { display: block; }
  #offcanvas-menu.is-open { translate: 0 0; }
  #menu-overlay.is-open { opacity: 1; pointer-events: auto; }
  li[data-sub].is-open .sub-grid { grid-template-rows: 1fr; }
  li[data-sub].is-open svg { transform: rotate(180deg); }
</style>
