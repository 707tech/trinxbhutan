---
import { formatVideoDate, type Video } from '../data/videos';
interface Props { video: Video }
const { video } = Astro.props;
---
<article class="group">
  <div class="overflow-hidden rounded-[22px] bg-black">
    <lite-youtube videoid={video.id} playlabel={`Play: ${video.title}`} params="rel=0" style={`background-image:url('${video.thumbnail}')`} class="!max-w-none"></lite-youtube>
  </div>
  <p class="eyebrow mt-5"><time datetime={video.published}>{formatVideoDate(video.published)}</time></p>
  <h3 class="t-h5 mt-2"><a href={video.url} target="_blank" rel="noopener noreferrer" class="transition-colors duration-300 hover:text-accent">{video.title}</a></h3>
  {video.description && <p class="mt-3 line-clamp-2 font-sans text-[14px] leading-6 text-neutral-600">{video.description}</p>}
</article>
