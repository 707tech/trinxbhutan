---
import { url } from '../../utils/url';
import VideoCard from '../VideoCard.astro';
import VideoAssets from '../VideoAssets.astro';
import Icon from '../Icon.astro';
import { videos, CHANNEL_URL } from '../../data/videos';
const latest = videos.slice(0, 3);
---
<section id="vlogs" class="section-y bg-card">
  <VideoAssets />
  <div class="container-x">
    <div class="reveal mb-10 flex flex-col items-start gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-4 md:mb-12">
      <div><p class="eyebrow">By G Man</p><h2 class="t-h2 mt-4">Latest Off-Road Trips</h2></div>
      <a href={url('/vlogs')} class="btn btn-outline shrink-0 whitespace-nowrap">All Vlogs</a>
    </div>
    {latest.length ? (
      <div class="grid gap-8 md:grid-cols-3 md:gap-5">
        {latest.map((v, i) => <div class="reveal" style={`--d:${i * 120}ms`}><VideoCard video={v} /></div>)}
      </div>
    ) : (
      <div class="reveal border border-black/10 bg-white p-10 text-center">
        <p class="t-body font-sans text-neutral-600">New off-road vlogs are coming soon. Watch them on YouTube in the meantime.</p>
        <a href={CHANNEL_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-6"><Icon name="arrow-right" size={14} /> Open the YouTube channel</a>
      </div>
    )}
  </div>
</section>
