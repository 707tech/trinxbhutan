---
import { url } from '../utils/url';
// Full-width hero slider — self-contained: data at the top, vanilla-JS logic at the bottom, no libraries.
// Swap the placeholder art in src/assets/hero/ (bike-1..3.png = transparent bike cut-outs).
import { Image } from 'astro:assets';
import bike1 from '../assets/hero/bike-1.png';
import bike2 from '../assets/hero/bike-2.png';
import bike3 from '../assets/hero/bike-3.png';
import Icon from './Icon.astro';

const slides = [
  { brand: 'Trinx', title: ['Hardtail', 'Bicycles'], subtitle: 'Relaxed Rides in Nature', watermark: 'Hardtail', bikeImage: bike1, bikeAlt: 'Trinx hardtail mountain bike', link: url('/bikes?type=mountain') },
  { brand: 'Trinx', title: ['Road', 'Bicycles'], subtitle: 'Built for Speed', watermark: 'Road', bikeImage: bike2, bikeAlt: 'Trinx road bike', link: url('/bikes?type=road') },
  { brand: 'Trinx', title: ['Action', 'Bicycles'], subtitle: 'Expert Mountain Bikers', watermark: 'Action', bikeImage: bike3, bikeAlt: 'Trinx gravel and adventure bike', link: url('/bikes') },
];
const arrow = 'group flex h-9 w-11 shrink-0 items-center justify-center rounded-xl border-[1.5px] border-accent bg-transparent text-black transition-colors duration-300 hover:bg-accent hover:text-white md:h-9 lg:absolute lg:top-1/2 lg:h-12 lg:w-[66px] lg:-translate-y-1/2 lg:rounded-2xl';
---
<section data-hero aria-roledescription="carousel" aria-label="Featured bicycles" class="relative overflow-hidden border-t border-neutral-200 bg-white font-display text-black">
  <div class="mx-auto grid max-w-[1200px] px-4 lg:min-h-[calc(100svh-112px)] lg:px-6">
    {slides.map((s, i) => (
      <div data-slide aria-hidden={String(i !== 0)} aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} data-active={String(i === 0)} class="slide col-start-1 row-start-1 grid grid-cols-1 content-start gap-y-6 pt-10 pb-24 lg:grid-cols-[30%_45%_20%] lg:grid-rows-[1fr_auto] lg:justify-between lg:gap-y-0 lg:pt-16 lg:pb-24">
        <!-- watermark word (behind the bike) -->
        <span data-watermark aria-hidden="true" class="pointer-events-none absolute top-[44%] left-1/2 z-0 -translate-x-1/2 -translate-y-1/2 text-[80px] leading-none font-medium whitespace-nowrap text-black/[0.06] uppercase select-none md:text-[120px] lg:text-[180px]">{s.watermark}</span>

        <!-- text -->
        <div class="relative z-20 lg:col-start-1 lg:row-start-1">
          <p data-stagger class="text-[12px] font-medium tracking-wide text-[#7a7a7a] uppercase">{s.brand}</p>
          <h2 data-stagger class="mt-4 text-[32px] leading-[1.06] font-medium tracking-tight uppercase md:text-[40px] lg:text-[55px] lg:leading-[58px]">
            {s.title.map((l) => <span class="block">{l}</span>)}
          </h2>
          <p data-stagger class="mt-4 text-[15px] leading-6 font-normal">{s.subtitle}</p>
        </div>

        <!-- bike -->
        <div class="relative z-10 flex items-center justify-center lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:-ml-[27%] lg:w-[142%]">
          <div data-bike class="w-full">
            <Image src={s.bikeImage} alt={s.bikeAlt} width={1400} sizes="(min-width:1024px) 900px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} class="h-auto w-full object-contain" />
          </div>
        </div>

        <!-- button -->
        <div data-stagger class="relative z-20 lg:col-start-1 lg:row-start-2 lg:self-end">
          <a href={s.link} tabindex={i === 0 ? 0 : -1} data-slide-link class="inline-flex items-center rounded-xl bg-accent px-7 py-4 text-[12px] leading-none font-medium text-white uppercase transition-colors duration-300 hover:bg-black">Shop Now</a>
        </div>
      </div>
    ))}

    <!-- controls: bottom bar on mobile, edge arrows on desktop -->
    <div class="absolute inset-x-0 bottom-5 z-30 flex items-center justify-center gap-3 lg:contents">
      <button type="button" data-prev aria-label="Previous slide" class={`${arrow} lg:left-5`}><Icon name="arrow-left" size={20} stroke={1.8} /></button>
      <div class="flex items-center gap-1 lg:absolute lg:bottom-6 lg:left-1/2 lg:-translate-x-1/2" role="group" aria-label="Choose slide">
        {slides.map((_, i) => (
          <button type="button" data-dot aria-label={`Go to slide ${i + 1}`} aria-current={String(i === 0)} class="flex h-8 min-w-9 items-center justify-center rounded-xl border-[1.5px] border-transparent px-2 text-[11px] font-bold transition-colors duration-300 hover:text-accent aria-[current=true]:border-accent">{String(i + 1).padStart(2, '0')}</button>
        ))}
      </div>
      <button type="button" data-next aria-label="Next slide" class={`${arrow} lg:right-5`}><Icon name="arrow-right" size={20} stroke={1.8} /></button>
    </div>
  </div>
</section>

<style is:global>
  /* Transition states. Inactive slides stay in the layout (grid-stacked) so the section keeps a stable height. */
  [data-hero] .slide { pointer-events: none; visibility: hidden; transition: visibility 0s linear 0.7s; }
  [data-hero] .slide[data-active='true'] { pointer-events: auto; visibility: visible; transition-delay: 0s; }

  [data-hero] [data-stagger] { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
  [data-hero] .slide[data-active='true'] [data-stagger] { opacity: 1; transform: none; transition-delay: calc(var(--i, 0) * 80ms + 120ms); }

  [data-hero] [data-bike] { opacity: 0; transform: translateX(var(--dx, 0px)); transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  [data-hero] .slide[data-active='true'] [data-bike] { opacity: 1; transform: none; }

  [data-hero] [data-watermark] { opacity: 0; transition: opacity 1s ease; }
  [data-hero] .slide[data-active='true'] [data-watermark] { opacity: 1; transition-delay: 0.2s; }


  @media (prefers-reduced-motion: reduce) {
    [data-hero] [data-stagger], [data-hero] [data-bike] { transform: none !important; transition: opacity 0.4s ease !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTOPLAY = 6000;
    let index = 0, timer: number | undefined, hovering = false, inView = true;

    // stagger order for the text elements inside each slide
    slides.forEach((s) => s.querySelectorAll<HTMLElement>('[data-stagger]').forEach((el, n) => el.style.setProperty('--i', String(n))));

    const go = (to: number, dir?: 1 | -1) => {
      const next = (to + slides.length) % slides.length;
      if (next === index) return;
      const direction = dir ?? (next > index ? 1 : -1);
      const incoming = slides[next];
      const bike = incoming.querySelector<HTMLElement>('[data-bike]')!;
      // place the incoming bike on the side it will slide in from (no transition), then activate
      if (!reduce) {
        bike.style.transition = 'none';
        bike.style.setProperty('--dx', `${direction * 60}px`);
        void bike.offsetWidth;
        bike.style.transition = '';
      }
      slides.forEach((s, n) => {
        const on = n === next;
        s.dataset.active = String(on);
        s.setAttribute('aria-hidden', String(!on));
        s.querySelectorAll('[data-slide-link]').forEach((a) => a.setAttribute('tabindex', on ? '0' : '-1'));
      });
      // the outgoing bike leaves in the opposite direction
      const out = slides[index].querySelector<HTMLElement>('[data-bike]')!;
      if (!reduce) out.style.setProperty('--dx', `${-direction * 60}px`);
      dots.forEach((d, n) => d.setAttribute('aria-current', String(n === next)));
      index = next;
      restart();
    };

    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const start = () => { if (!reduce && !timer && !hovering && inView && !document.hidden) timer = window.setInterval(() => go(index + 1, 1), AUTOPLAY); };
    const restart = () => { stop(); start(); };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1, -1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1, 1));
    dots.forEach((d, n) => d.addEventListener('click', () => go(n)));

    // keyboard ← → (only while the hero is on screen and no field is focused)
    document.addEventListener('keydown', (e) => {
      if (!inView || (e.target as HTMLElement).closest?.('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowLeft') go(index - 1, -1);
      if (e.key === 'ArrowRight') go(index + 1, 1);
    });

    // swipe
    let x0 = 0, y0 = 0;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });

    // autoplay pauses: hover, hidden tab, off-screen
    root.addEventListener('mouseenter', () => { hovering = true; stop(); });
    root.addEventListener('mouseleave', () => { hovering = false; start(); });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { inView = e.isIntersecting; inView ? start() : stop(); }, { threshold: 0.3 }).observe(root);

    start();
  });
</script>
