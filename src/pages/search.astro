---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Search" description="Search bikes, parts, articles and pages." noindex>
  <PageTitle title="Search" image="1534787238916-9ba6764efd4f" />
  <section class="section-y" data-search-page>
    <div class="container-x max-w-3xl">
      <form action={url('/search')} method="get" role="search" class="flex items-center gap-2 border-b-2 border-black pb-3 sm:gap-3">
        <Icon name="search" size={22} class="shrink-0" />
        <input name="q" type="search" data-q autocomplete="off" placeholder="Search bikes, parts, articles…" aria-label="Search" class="min-w-0 flex-1 bg-transparent text-[15px] uppercase outline-none placeholder:text-neutral-400 sm:text-[18px]" />
        <button type="submit" class="btn btn-primary shrink-0 px-4 sm:px-[26px]">Search</button>
      </form>
      <p data-summary class="mt-8 text-[10px] tracking-[0.3px] uppercase" aria-live="polite"></p>
      <ul data-list class="mt-6 divide-y divide-neutral-200 border-y border-neutral-200"></ul>
    </div>
  </section>
  <script>
    import { searchHits } from '../scripts/ui';
    import { url } from '../utils/url';
    const root = document.querySelector<HTMLElement>('[data-search-page]')!;
    const q = (new URLSearchParams(location.search).get('q') || '').trim();
    root.querySelector<HTMLInputElement>('[data-q]')!.value = q;
    const summary = root.querySelector('[data-summary]')!;
    const list = root.querySelector('[data-list]')!;
    if (!q) summary.textContent = 'Type something to search the site.';
    else fetch(url('/search-index.json')).then((r) => r.json()).then((idx) => {
      const hits = searchHits(q, idx);
      summary.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'} for “${q}”`;
      list.innerHTML = hits.map((h: any) => `<li><a href="${h.u}" class="flex items-center justify-between gap-4 py-5 transition-colors hover:text-accent"><span><span class="text-[10px] text-muted uppercase">${h.k}</span><span class="block text-[14px] font-semibold uppercase">${h.t}</span></span>${h.p ? `<span class="text-[13px] font-semibold">Nu. ${h.p.toLocaleString('en-IN')}</span>` : ''}</a></li>`).join('');
    });
  </script>
</BaseLayout>
