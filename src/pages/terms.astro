---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import { termsSections, termsUpdated } from '../data/terms';
const updated = new Date(termsUpdated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title="Terms & Conditions" description="Terms and conditions for Gangjung Traders, Bhutan — orders, pricing, delivery, returns, warranty and privacy." active="About">
  <PageTitle title="Terms & Conditions" image="1534787238916-9ba6764efd4f" />
  <section class="section-y">
    <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:gap-20">
      <nav aria-label="Contents" class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">Contents</p>
        <ol class="mt-4 space-y-1">
          {termsSections.map((s, i) => <li><a href={`#${s.id}`} class="flex gap-3 py-1.5 text-[11px] uppercase transition-colors duration-300 hover:text-accent"><span class="text-muted">{String(i + 1).padStart(2, '0')}</span>{s.title}</a></li>)}
        </ol>
      </nav>
      <div class="max-w-3xl">
        <p class="eyebrow">Last updated {updated}</p>
        <p class="mt-3 font-sans text-[13px] text-muted">Placeholder wording — please have it reviewed for your business before going live.</p>
        <div class="mt-10 space-y-14">
          {termsSections.map((s, i) => (
            <section id={s.id} class="scroll-mt-28">
              <h2 class="t-h4"><span class="mr-3 text-accent">{String(i + 1).padStart(2, '0')}</span>{s.title}</h2>
              <div class="mt-5 space-y-4 font-sans text-[15px] leading-7 text-neutral-600">
                {s.paragraphs.map((p) => <p>{p}</p>)}
                {s.list && <ul class="space-y-2">{s.list.map((l) => <li class="flex gap-3"><span aria-hidden="true" class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span>{l}</span></li>)}</ul>}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
