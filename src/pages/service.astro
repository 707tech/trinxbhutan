---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import Icon from '../components/Icon.astro';
import { repairPrices, servicePackages, serviceSteps } from '../data/service';
import { LOCATIONS, WHATSAPP_NUMBER, whatsappLink } from '../data/site';
import { formatPrice } from '../lib/format';
---
<BaseLayout title="Bike Servicing" description="Bike servicing and repairs at our Thimphu workshop. See prices and book on WhatsApp." active="Servicing">
  <PageTitle title="Bike Servicing" image="1572111504021-40abd3479ddb" />

  <section class="section-y">
    <div class="container-x">
      <div class="reveal grid gap-10 lg:grid-cols-2 lg:gap-20">
        <div><p class="eyebrow">Workshop</p><h2 class="t-h2 mt-4">Keep your bike<br />running sweet</h2></div>
        <p class="t-body self-end font-sans text-neutral-600">From a quick safety check to a full strip-down, our mechanics service every kind of bicycle — whether you bought it from us or not. We always confirm the price before starting extra work.</p>
      </div>
      <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {serviceSteps.map((s, i) => (
          <li class="reveal border-t-2 border-accent pt-5" style={`--d:${i * 100}ms`}>
            <span class="t-h3 text-accent">{String(i + 1).padStart(2, '0')}</span>
            <p class="t-h5 mt-3">{s.title}</p>
            <p class="mt-2 font-sans text-[13px] leading-6 text-neutral-600">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="packages" aria-labelledby="packages-heading" class="scroll-mt-24 bg-black pb-[clamp(64px,8vw,110px)] text-white">
    <div class="container-x pt-[clamp(64px,8vw,110px)]">
      <p class="eyebrow text-white/60">Service packages</p>
      <h2 id="packages-heading" class="t-h2 mt-4">Choose your service</h2>
      <div class="mt-12 grid gap-px bg-white/15 sm:grid-cols-2 lg:grid-cols-4">
        {servicePackages.map((p) => (
          <article class:list={['relative flex flex-col p-7', p.popular ? 'bg-accent' : 'bg-black']}>
            {p.popular && <span class="absolute top-5 right-5 rounded-full bg-black px-3 py-1 text-[10px] font-medium uppercase">Most popular</span>}
            <p class:list={['text-[10px] uppercase', p.popular ? 'text-white/80' : 'text-white/50']}>{p.time}</p>
            <h3 class="t-h4 mt-3">{p.name}</h3>
            <p class="mt-4 text-[13px] uppercase">From <span class="text-[26px] font-semibold">{formatPrice(p.price)}</span></p>
            <p class:list={['mt-3 font-sans text-[13px] leading-6', p.popular ? 'text-white/90' : 'text-white/65']}>{p.summary}</p>
            <ul class="mt-6 space-y-2.5 text-[12px]">
              {p.includes.map((inc) => <li class="flex gap-2.5"><Icon name="check" size={14} stroke={2.5} class:list={['mt-0.5 shrink-0', p.popular ? 'text-white' : 'text-accent']} /><span class="font-sans">{inc}</span></li>)}
            </ul>
            <a href="#book" class:list={['btn mt-8 self-start', p.popular ? 'bg-black text-white hover:bg-white hover:text-black' : 'btn-outline text-white']}>Book <Icon name="arrow-right" size={14} /></a>
          </article>
        ))}
      </div>
      <p class="mt-5 font-sans text-[12px] text-white/50">Prices are for labour. Parts are extra and always quoted first. *Cables and housing charged as parts. Sample prices — set your real prices before launch.</p>
    </div>
  </section>

  <section id="book" class="section-y scroll-mt-24">
    <div class="container-x grid gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
      <div>
        <p class="eyebrow">Repairs</p>
        <h2 class="t-h2 mt-4">Common repairs</h2>
        <table class="mt-8 w-full text-left">
          <tbody class="divide-y divide-neutral-200 border-y border-neutral-200">
            {repairPrices.map((r) => <tr><th scope="row" class="py-4 pr-4 font-sans text-[14px] font-normal text-neutral-700">{r.item}</th><td class="py-4 text-right text-[12px] font-semibold whitespace-nowrap uppercase">{r.price}</td></tr>)}
          </tbody>
        </table>
        <p class="mt-6 font-sans text-[13px] text-muted">Bought a bike from us? Your first service is free. See the <a href={url('/faq#service')} class="underline hover:text-accent">service FAQ</a>.</p>
      </div>

      <form data-service-form data-wa={WHATSAPP_NUMBER} novalidate class="border border-neutral-200 bg-card p-7 md:p-10">
        <h3 class="t-h4">Book a service</h3>
        <p class="mt-3 font-sans text-[13px] text-muted">Your booking opens in WhatsApp, ready to send. We’ll reply to confirm a time.</p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <label class="block"><span class="text-[10px] font-semibold uppercase">Service</span>
            <span class="relative block"><select name="service" class="mt-2 w-full cursor-pointer appearance-none pr-12 rounded-[17px] border border-neutral-300 bg-white px-5 py-3.5 font-sans text-[14px] focus:border-accent focus:outline-none">
              {servicePackages.map((p) => <option value={p.name} selected={p.popular}>{p.name} — from {formatPrice(p.price)}</option>)}
              <option value="Repair / not sure">Repair / not sure</option>
            </select><Icon name="chev-down" size={14} class="pointer-events-none absolute top-1/2 right-5 mt-1 -translate-y-1/2 text-neutral-500" /></span></label>
          <label class="block"><span class="text-[10px] font-semibold uppercase">Service centre</span>
            <span class="relative block"><select name="centre" class="mt-2 w-full cursor-pointer appearance-none pr-12 rounded-[17px] border border-neutral-300 bg-white px-5 py-3.5 font-sans text-[14px] focus:border-accent focus:outline-none">{LOCATIONS.map((l) => <option value={l.name}>{l.name}</option>)}</select><Icon name="chev-down" size={14} class="pointer-events-none absolute top-1/2 right-5 mt-1 -translate-y-1/2 text-neutral-500" /></span></label>
          <label class="block"><span class="text-[10px] font-semibold uppercase">Name *</span><input name="name" autocomplete="name" class="mt-2 w-full rounded-[17px] border border-neutral-300 bg-white px-5 py-3.5 font-sans text-[14px] focus:border-accent focus:outline-none" /><p data-err="name" class="mt-1.5 text-[11px] text-red-600"></p></label>
          <label class="block"><span class="text-[10px] font-semibold uppercase">Phone *</span><input name="phone" type="tel" autocomplete="tel" class="mt-2 w-full rounded-[17px] border border-neutral-300 bg-white px-5 py-3.5 font-sans text-[14px] focus:border-accent focus:outline-none" /><p data-err="phone" class="mt-1.5 text-[11px] text-red-600"></p></label>
          <label class="block"><span class="text-[10px] font-semibold uppercase">Your bike *</span><input name="bike" placeholder="e.g. Trinx Climber 1.0, hardtail MTB…" class="mt-2 w-full rounded-[17px] border border-neutral-300 bg-white px-5 py-3.5 font-sans text-[14px] focus:border-accent focus:outline-none" /><p data-err="bike" class="mt-1.5 text-[11px] text-red-600"></p></label>
          <label class="block"><span class="text-[10px] font-semibold uppercase">Preferred date</span><input name="date" type="date" class="mt-2 w-full rounded-[17px] border border-neutral-300 bg-white px-5 py-3.5 font-sans text-[14px] focus:border-accent focus:outline-none" /></label>
          <label class="block sm:col-span-2"><span class="text-[10px] font-semibold uppercase">What needs doing?</span><textarea name="notes" rows="4" placeholder="Noises, problems, anything we should know…" class="mt-2 w-full resize-y rounded-[17px] border border-neutral-300 bg-white px-5 py-3.5 font-sans text-[14px] focus:border-accent focus:outline-none"></textarea></label>
        </div>
        <button type="submit" class="btn btn-primary mt-8 w-full sm:w-auto"><Icon name="chat" size={16} /> Book on WhatsApp</button>
        <p data-status role="status" class="mt-4 text-[11px] font-medium text-accent uppercase"></p>
      </form>
    </div>
  </section>

  <section aria-labelledby="centres-heading" class="bg-card py-[clamp(64px,8vw,110px)]">
    <div class="container-x">
      <div class="mb-12"><p class="eyebrow">Find us</p><h2 id="centres-heading" class="t-h2 mt-4">Our service centre</h2></div>
      <div class="grid gap-6 lg:grid-cols-2">
        {LOCATIONS.map((loc) => {
          const q = encodeURIComponent(loc.mapQuery);
          return (
            <article id={loc.slug} class="scroll-mt-28 overflow-hidden border border-neutral-200 bg-white">
              <div class="relative h-[280px] bg-card">
                <iframe title={`Map showing the ${loc.name}`} src={`https://www.google.com/maps?q=${q}&z=15&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="absolute inset-0 h-full w-full border-0 grayscale transition-[filter] duration-500 hover:grayscale-0"></iframe>
                <span class="absolute top-4 left-4 rounded-full bg-black px-3 py-1.5 text-[10px] font-medium text-white uppercase">{loc.city}</span>
              </div>
              <div class="p-7 md:p-9">
                <h3 class="t-h4">{loc.name}</h3>
                <p class="mt-2 font-sans text-[13px] text-muted">{loc.note}</p>
                <ul class="mt-6 space-y-4 text-[13px]">
                  <li class="flex gap-3"><Icon name="pin" size={18} class="mt-0.5 shrink-0 text-accent" /><span class="font-semibold uppercase">{loc.address}</span></li>
                  <li class="flex gap-3"><Icon name="phone" size={18} class="mt-0.5 shrink-0 text-accent" /><a href={loc.phoneHref} class="font-semibold transition-colors duration-300 hover:text-accent">{loc.phoneDisplay}</a></li>
                  <li class="flex gap-3"><Icon name="mail" size={18} class="mt-0.5 shrink-0 text-accent" /><a href={`mailto:${loc.email}`} class="font-sans transition-colors duration-300 hover:text-accent">{loc.email}</a></li>
                  <li class="flex gap-3"><Icon name="clock" size={18} class="mt-0.5 shrink-0 text-accent" /><dl class="space-y-1 uppercase">{loc.hours.map((h) => <div class="flex gap-3"><dt class="font-semibold">{h.days}</dt><dd class="text-muted">{h.time}</dd></div>)}</dl></li>
                </ul>
                <div class="mt-8 flex flex-wrap gap-3">
                  <a href={whatsappLink(`Hi Gangjung Traders, I'd like to book a service at the ${loc.name}. My bike is: `)} target="_blank" rel="noopener noreferrer" class="btn btn-primary"><Icon name="chat" size={16} /> Book here</a>
                  <a href={`https://www.google.com/maps/search/?api=1&query=${q}`} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Directions <Icon name="arrow-right" size={14} /></a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
  <script>
    import '../scripts/forms';
  </script>
</BaseLayout>
