---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Icon from '../components/Icon.astro';
import { WHATSAPP_NUMBER } from '../data/site';
---
<BaseLayout title="Cart" description="Your cart — send your order to Gangjung Traders on WhatsApp." active="Shop" noindex>
  <div class="container-x pt-8 pb-[clamp(64px,8vw,110px)]" data-cart-page data-wa={WHATSAPP_NUMBER}>
    <Breadcrumb items={[{ label: 'Home', href: url('/') }, { label: 'Cart' }]} />
    <div class="mt-[60px]">
      <div data-loading class="min-h-[300px]" aria-busy="true"></div>

      <div data-empty hidden class="flex flex-col items-center py-16 text-center md:py-24">
        <Icon name="bag" size={56} stroke={1} class="text-muted" />
        <h1 class="t-h4 mt-6">Your cart is currently empty</h1>
        <a href={url('/shop')} class="btn btn-outline mt-8 px-[22px] py-3">Return to shop</a>
      </div>

      <div data-full hidden>
        <h1 class="sr-only">Cart</h1>
        <table class="block w-full text-left md:table">
          <thead class="hidden md:table-header-group">
            <tr class="border-b border-neutral-200">
              <th class="w-10 pb-4 text-[10px] font-semibold uppercase"><span class="sr-only">Remove</span></th>
              <th class="w-[84px] pb-4 text-[10px] font-semibold uppercase"><span class="sr-only">Image</span></th>
              <th class="pb-4 text-[10px] font-semibold uppercase">Product</th>
              <th class="w-[160px] pb-4 text-center text-[10px] font-semibold uppercase">Price</th>
              <th class="w-[200px] pb-4 text-center text-[10px] font-semibold uppercase">Quantity</th>
              <th class="w-[160px] pb-4 text-right text-[10px] font-semibold uppercase">Subtotal</th>
            </tr>
          </thead>
          <tbody data-rows class="block md:table-row-group"></tbody>
        </table>

        <section aria-labelledby="totals-heading" class="mt-16 w-full md:w-1/2">
          <h2 id="totals-heading" class="t-h3">Cart totals</h2>
          <table class="mt-6 w-full">
            <tbody class="divide-y divide-neutral-200 border-y border-neutral-200">
              <tr><th scope="row" class="py-4 text-left text-[10px] font-semibold uppercase">Subtotal</th><td data-subtotal class="py-4 text-right text-[14px] font-semibold"></td></tr>
              <tr><th scope="row" class="py-4 text-left text-[10px] font-semibold uppercase">Total</th><td data-total class="py-4 text-right text-[14px] font-semibold"></td></tr>
            </tbody>
          </table>
          <a data-wa-link href="#" target="_blank" rel="noopener noreferrer" class="btn btn-outline mt-8 w-full px-[22px] py-3 md:w-auto"><Icon name="chat" size={16} /> Enquire on WhatsApp</a>
          <p class="mt-4 font-sans text-[12px] text-muted">Your cart is sent to us on WhatsApp — we’ll confirm availability and how to pay.</p>
        </section>
      </div>
    </div>
  </div>
  <script>
    import '../scripts/cart-page';
  </script>
</BaseLayout>
