---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoAssets from '../components/VideoAssets.astro';
import Icon from '../components/Icon.astro';
import { videos, CHANNEL_URL, CHANNEL_NAME } from '../data/videos';
---
<BaseLayout title="Vlogs" description="Off-road trips and rides from G Man Bhutan, the YouTube channel of Gangjung Traders founder Ugen." active="Vlogs">
  <VideoAssets />

  <PageHero title="Vlogs" eyebrow={`${CHANNEL_NAME} · YouTube`} intro="Off-road trips and rides across Bhutan. New videos appear here automatically when they are published on YouTube." id="vlogs-heading">
    <a slot="actions" href={`${CHANNEL_URL}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer" class="btn btn-primary hover:bg-white hover:text-black"><Icon name="youtube" size={16} /> Subscribe on YouTube</a>
  </PageHero>

  <!-- Videos -->
  <section aria-label="Videos" class="section-y">
    <div class="container-x">
      {videos.length ? (
        <div class="grid gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {videos.map((v, i) => <div class="reveal" style={`--d:${(i % 3) * 120}ms`}><VideoCard video={v} /></div>)}
        </div>
      ) : (
        <div class="border border-black/10 bg-card p-12 text-center"><p class="t-body font-sans text-neutral-600">No videos to show right now. Please check the channel directly.</p><a href={CHANNEL_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline mt-6">Open YouTube channel</a></div>
      )}
    </div>
  </section>
</BaseLayout>
